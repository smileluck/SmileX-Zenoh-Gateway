# ============================================
# SmileX Zenoh Gateway 环境变量配置模板
# 使用方式：复制此文件为 .env，然后根据需要修改配置
# ============================================

# ============================================
# 应用基本配置
# ============================================

# 应用名称
SMILEX_APP_NAME=SmileX Zenoh Gateway

# 应用版本
SMILEX_APP_VERSION=0.1.0

# 调试模式（true/false）
SMILEX_DEBUG=true

# ============================================
# Zenoh 网络配置
# ============================================

# Zenoh 连接端点（用于连接到现有 Zenoh 路由器）
# 示例: tcp/192.168.1.100:7447
SMILEX_ZENOH_CONNECT=

# Zenoh 监听端点（用于作为 Zenoh 路由器）
SMILEX_ZENOH_LISTEN=tcp/0.0.0.0:7447

# ============================================
# API 服务配置
# ============================================

# API 服务监听地址
SMILEX_API_HOST=0.0.0.0

# API 服务监听端口
SMILEX_API_PORT=8000

# ============================================
# 设备管理配置
# ============================================

# 心跳间隔（秒）
SMILEX_HEARTBEAT_INTERVAL=1.0

# 心跳超时（秒）
SMILEX_HEARTBEAT_TIMEOUT=3.0

# 最大设备数
SMILEX_MAX_DEVICES=50

# ============================================
# 日志配置
# ============================================

# 日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
SMILEX_LOG_LEVEL=INFO

# 日志文件路径（留空则仅输出到控制台）
SMILEX_LOG_FILE=logs/app.log

# 单个日志文件最大大小（字节）
SMILEX_LOG_MAX_BYTES=10485760

# 保留的日志文件备份数
SMILEX_LOG_BACKUP_COUNT=5

# ============================================
# 安全配置
# ============================================

# 是否启用 TLS（true/false）
SMILEX_ENABLE_TLS=false

# TLS 证书路径
SMILEX_TLS_CERT_PATH=

# TLS 私钥路径
SMILEX_TLS_KEY_PATH=

# TLS CA 证书路径
SMILEX_TLS_CA_CERT_PATH=

# ============================================
# 安全密钥配置（生产环境请修改！）
# ============================================

# 加密密钥（Base64 编码的 32 字节密钥）
# 生成方式：python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SMILEX_ENCRYPTION_KEY=

# JWT/Token 签名密钥
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SMILEX_TOKEN_SECRET=
