{
  "mode": "router",
  "connect": {
    "endpoints": []
  },
  "listen": {
    "endpoints": [
      "tcp/0.0.0.0:7447"
    ]
  },
  "scouting": {
    "multicast": {
      "enabled": true,
      "interface": "auto",
      "address": "224.0.0.224:7446"
    },
    "gossip": {
      "enabled": false,
      "seed": []
    }
  },
  "transport": {
    "link": {
      "tcp": {
        "accept_timeout": "10s",
        "accept_backlog": 100,
        "max_sessions": 1000
      },
      "unix": {
        "enabled": false
      }
    }
  },
  "timestamping": {
    "enabled": false,
    "source": "local"
  }
}
